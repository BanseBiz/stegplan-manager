[Unit]
Description=ORVO Stegplan Flask App
After=network.target postgresql.service
Wants=postgresql.service

[Service]
User=stegplan
Group=stegplan
WorkingDirectory=/opt/stegplan
ExecStart=/opt/stegplan/venv/bin/python /opt/stegplan/app.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
